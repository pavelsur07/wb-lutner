# crontab пользователя wblutner:  crontab -e
# Время сервера должно быть МСК:  sudo timedatectl set-timezone Europe/Moscow
PATH=/usr/bin:/bin

# Синхронизация каталога Lutner (полный прайс) — ночью
0 3 * * *  flock -n /tmp/catalog.lock  -c 'cd /opt/wb-lutner && venv/bin/python sync_catalog.py'

# Основной цикл: заказы WB -> Lutner
*/5 * * * *  flock -n /tmp/main.lock    -c 'cd /opt/wb-lutner && venv/bin/python main.py'
# ПЕРВУЮ НЕДЕЛЮ — с --dry-run:
# */5 * * * * flock -n /tmp/main.lock -c 'cd /opt/wb-lutner && venv/bin/python main.py --dry-run'

# Остатки SPB -> WB
*/10 * * * * flock -n /tmp/stock-sync.lock -c 'cd /opt/wb-lutner && venv/bin/python sync_stock_to_wb.py'

# Живость webhook (алерт если тишина >15 мин)
*/10 * * * * flock -n /tmp/heartbeat.lock  -c 'cd /opt/wb-lutner && venv/bin/python check_heartbeat.py'

# Напоминание/проверка баланса Lutner перед 8:00
30 6 * * *  flock -n /tmp/balance.lock  -c 'cd /opt/wb-lutner && venv/bin/python check_balance.py'

# Утреннее письмо менеджеру Lutner (запас до 8:00)
30 7 * * *  flock -n /tmp/morning.lock  -c 'cd /opt/wb-lutner && venv/bin/python morning_report.py'

# Вечерний отчёт себе
0 20 * * *  flock -n /tmp/summary.lock  -c 'cd /opt/wb-lutner && venv/bin/python daily_summary.py'

# Бэкап БД + ротация 7 дней
0 2 * * *  sqlite3 /opt/wb-lutner/data/db.sqlite ".backup /opt/wb-lutner/data/db-$(date +\%F).sqlite" && find /opt/wb-lutner/data/db-*.sqlite -mtime +7 -delete
