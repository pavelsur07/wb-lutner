# crontab пользователя wblutner:  crontab -e
# Время сервера должно быть МСК:  sudo timedatectl set-timezone Europe/Moscow
# Соответствует проду (сверено 02.10.2026). Логи: logs/cron_*.log
PATH=/usr/bin:/bin

# Синхронизация каталога Lutner (полный прайс) — ночью
0 3 * * *  flock -n /tmp/catalog.lock  -c "cd /opt/wb-lutner && venv/bin/python sync_catalog.py >> logs/cron_catalog.log 2>&1"

# Основной цикл: заказы WB -> Lutner
*/5 * * * *  flock -n /tmp/main.lock    -c "cd /opt/wb-lutner && venv/bin/python main.py >> logs/cron_main.log 2>&1"
# Для проверки — с --dry-run:
# */5 * * * * flock -n /tmp/main.lock -c "cd /opt/wb-lutner && venv/bin/python main.py --dry-run >> logs/cron_main.log 2>&1"

# Основной цикл: заказы Ozon -> Lutner
*/5 * * * *  flock -n /tmp/ozon-main.lock -c "cd /opt/wb-lutner && venv/bin/python ozon_main.py >> logs/cron_ozon_main.log 2>&1"

# Остатки SPB -> WB / Ozon
*/10 * * * * flock -n /tmp/stock-sync.lock -c "cd /opt/wb-lutner && venv/bin/python sync_stock_to_wb.py >> logs/cron_stock.log 2>&1"
*/10 * * * * flock -n /tmp/ozon-stock.lock -c "cd /opt/wb-lutner && venv/bin/python sync_stock_to_ozon.py >> logs/cron_ozon_stock.log 2>&1"

# Маппинг баркодов/артикулов WB и Ozon -> Lutner
*/15 * * * * flock -n /tmp/mapping.lock -c "cd /opt/wb-lutner && venv/bin/python initial_mapping.py >> logs/cron_mapping.log 2>&1"
*/15 * * * * flock -n /tmp/ozon-mapping.lock -c "cd /opt/wb-lutner && venv/bin/python ozon_mapping.py >> logs/cron_ozon_mapping.log 2>&1"

# Живость webhook (алерт если тишина >15 мин)
*/10 * * * * flock -n /tmp/heartbeat.lock -c "cd /opt/wb-lutner && venv/bin/python check_heartbeat.py >> logs/cron_heartbeat.log 2>&1"

# Вечерний отчёт себе
0 20 * * *  flock -n /tmp/summary.lock -c "cd /opt/wb-lutner && venv/bin/python daily_summary.py >> logs/cron_summary.log 2>&1"

# Бэкап БД + ротация 7 дней
0 2 * * * sqlite3 /opt/wb-lutner/data/db.sqlite ".backup /opt/wb-lutner/data/db-$(date +\%F).sqlite" && find /opt/wb-lutner/data -name "db-*.sqlite" -mtime +7 -delete

# Проверка баланса Lutner перед 8:00
30 6 * * *  flock -n /tmp/balance.lock  -c "cd /opt/wb-lutner && venv/bin/python check_balance.py >> logs/cron_balance.log 2>&1"

# Утреннее письмо менеджеру Lutner (запас до 8:00)
30 7 * * *  flock -n /tmp/morning.lock  -c "cd /opt/wb-lutner && venv/bin/python morning_report.py >> logs/cron_morning.log 2>&1"
